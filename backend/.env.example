# Copy this file to .ENV and fill in your real values
# NEVER commit .ENV to Git

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGODB_DB=guardian_health

# Together.ai API Configuration
TOGETHER_API_KEY=your_together_api_key_here
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# JWT Configuration — generate a strong random key, e.g.:
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-strong-random-secret

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,https://your-username.github.io

# AWS (only needed for production Lambda deploy)
AWS_REGION=us-east-1
DYNAMODB_TABLE=guardian-health-sessions
LAMBDA_FUNCTION_NAME=guardian-health-triage
