# =============================================================================
# GuardianHealth v2 - Docker Ignore
# =============================================================================
# Files and directories excluded from Docker build context.
# Keeps build context small and prevents secrets from being copied.
# =============================================================================

# --- Git ---
.git
.gitignore
.gitattributes

# --- Node.js (Frontend) ---
node_modules
npm-debug.log
yarn-error.log
.pnpm-debug.log

# --- Python (Backend) ---
__pycache__
*.py[cod]
*$py.class
*.so
.Python
.venv
venv/
env/
ENV/

# --- Build outputs ---
dist
build
*.egg-info

# --- Environment / Secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- IDE / Editor ---
.vscode
.idea
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db

# --- Testing ---
.pytest_cache
.coverage
htmlcov
.tox

# --- Misc ---
*.log
README.md
CHANGELOG.md
LICENSE
.github
