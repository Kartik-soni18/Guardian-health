# GuardianHealth — single env file for the whole project
# cp .env.example .env

# --- Backend ---
SECRET_KEY=your-super-secret-key-at-least-32-characters-long

# MongoDB Atlas — replace <db_password> with your cluster password
MONGODB_URI=mongodb+srv://kartik-medical:<db_password>@cluster0.jzylktb.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=guardian

# Upstash Redis — optional; leave blank to use in-memory cache and rate limits
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_URL=
CACHE_TTL_SECONDS=3600

TOGETHER_API_KEY=your-together-api-key
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
TOGETHER_BASE_URL=https://api.together.xyz/v1

MOCK_MODE=false

# CORS origin is host only (no path). App: https://kartik-soni18.github.io/Guardian-health/
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:3000,https://kartik-soni18.github.io
LOG_LEVEL=INFO

# --- Frontend (Vite reads VITE_* from this same file) ---
VITE_API_URL=http://localhost:8000/api/v1
# Production (Lambda Function URL + /api/v1):
# VITE_API_URL=https://<id>.lambda-url.ap-southeast-2.on.aws/api/v1
# VITE_STREAM_API_URL=https://<id>.lambda-url.ap-southeast-2.on.aws/api/v1
