# ==========================================
# GuardianHealth v2 — Environment Variables
# ==========================================
# Copy to .env and fill in your values:
#   cp .env.example .env

# ------------------------------------------------------------------
# Core Security
# ------------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-me-immediately

# ------------------------------------------------------------------
# AWS / DynamoDB Configuration
# ------------------------------------------------------------------
# AWS region (always-free DynamoDB on us-east-1, us-west-2, eu-west-1)
AWS_REGION=us-east-1

# Optional: local DynamoDB endpoint (auto-set by docker-compose)
# DYNAMODB_ENDPOINT_URL=http://localhost:8000

# Table prefix for multi-env isolation (prod, staging, dev)
DYNAMODB_TABLE_PREFIX=guardian-dev

# For production AWS: leave AWS_ACCESS_KEY_ID empty to use IAM role
# or instance profile / Lambda execution role.
# For local dev, docker-compose sets dummy values automatically.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------
# AI / LLM Configuration (Together.ai)
# ------------------------------------------------------------------
# Get your free API key: https://api.together.xyz/
TOGETHER_API_KEY=your-together-api-key

# Model identifier (free tier via Together)
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# ------------------------------------------------------------------
# NCBI / PubMed Integration
# ------------------------------------------------------------------
# Your email for NCBI E-utilities compliance
NCBI_EMAIL=your-email@example.com

# NCBI API key (optional, increases rate limits)
# Get one: https://ncbiinsights.ncbi.nlm.nih.gov/2017/11/02/new-api-keys-for-the-e-utilities/
NCBI_API_KEY=your-ncbi-api-key

# ------------------------------------------------------------------
# Feature Flags
# ------------------------------------------------------------------
# MOCK_MODE: when "true", skip external API calls (safe for testing)
MOCK_MODE=false

# ------------------------------------------------------------------
# CORS / Networking
# ------------------------------------------------------------------
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:8000

# ------------------------------------------------------------------
# Observability
# ------------------------------------------------------------------
LOG_LEVEL=INFO
# LOG_LEVEL=DEBUG   # verbose (development)
# LOG_LEVEL=WARNING # production
